# Default: AI disabled. The product fully ships in this state.
AI_ENABLED=false

# Set AI_ENABLED=true and configure a provider to enable AI augmentation.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# HTTP server.
PORT=3000

# DB. Omit for in-memory PGLite. Set to a path (e.g. ./data) to persist.
# DATA_DIR=./data
